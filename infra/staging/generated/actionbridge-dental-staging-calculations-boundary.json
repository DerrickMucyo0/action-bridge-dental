{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "OwnLogStreams",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": "arn:aws:logs:us-east-2:631367363628:log-group:/aws/lambda/actionbridge-dental-staging-calculations:log-stream:*"
    },
    {
      "Sid": "ReadStagingCase",
      "Effect": "Allow",
      "Action": [
        "dynamodb:GetItem"
      ],
      "Resource": "arn:aws:dynamodb:us-east-2:631367363628:table/actionbridge-dental-staging-cases"
    },
    {
      "Sid": "NoOtherActions",
      "Effect": "Deny",
      "NotAction": [
        "dynamodb:GetItem",
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": "*"
    },
    {
      "Sid": "NoOtherResources0",
      "Effect": "Deny",
      "Action": [
        "dynamodb:GetItem"
      ],
      "NotResource": [
        "arn:aws:dynamodb:us-east-2:631367363628:table/actionbridge-dental-staging-cases"
      ]
    },
    {
      "Sid": "NoOtherResources1",
      "Effect": "Deny",
      "Action": [
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "NotResource": [
        "arn:aws:logs:us-east-2:631367363628:log-group:/aws/lambda/actionbridge-dental-staging-calculations:log-stream:*"
      ]
    }
  ]
}
